{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leadpoet/intent-analysis-system/schema/intent_output.schema.json",
  "title": "IntentDetails",
  "description": "Intent evidence returned by the engine for one company.",
  "type": "object",
  "properties": {
    "company": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "linkedin": { "type": "string" }
      },
      "required": ["name", "domain"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "description": "Discovered intent evidence items.",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "analyzed_at": {
      "type": "string",
      "description": "UTC timestamp when the analysis was produced.",
      "format": "date-time"
    }
  },
  "required": ["company", "evidence"],
  "additionalProperties": false,
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "properties": {
        "evidence_url": {
          "type": "string",
          "description": "Source URL for the intent evidence.",
          "format": "uri"
        },
        "evidence_type": {
          "type": "string",
          "description": "Category of intent evidence.",
          "enum": ["hiring", "pr", "funding", "tech_stack", "news", "social_media"]
        },
        "details": {
          "type": "string",
          "description": "Description of the evidence and why it signals intent."
        }
      },
      "required": ["evidence_url", "evidence_type", "details"],
      "additionalProperties": false
    }
  }
}
