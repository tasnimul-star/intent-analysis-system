{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tasnimul-star/intent-analysis-system/schema/company_input.schema.json",
  "title": "CompanyInput",
  "description": "Company identity supplied to the intent analysis engine.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name."
    },
    "domain": {
      "type": "string",
      "description": "Company root domain (e.g. example.com)."
    },
    "linkedin": {
      "type": "string",
      "description": "Company LinkedIn URL (optional).",
      "format": "uri"
    }
  },
  "required": ["name", "domain"],
  "additionalProperties": false
}
